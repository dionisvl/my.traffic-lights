# Copy to .env for production and replace every placeholder with deployment-specific values.
DOMAIN=example.com
ACME_EMAIL=ops@example.com
TRAEFIK_NETWORK=traefik
POSTGRES_USER=game
POSTGRES_PASSWORD=change-me
POSTGRES_DB=game_db
